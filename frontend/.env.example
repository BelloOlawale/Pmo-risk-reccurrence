# Base URL for the backend API. Leave empty to use the Vite dev proxy
# (relative /api URLs). Set to an absolute URL when the API lives elsewhere.
VITE_API_BASE_URL=

# Entra ID (MSAL) configuration. When both are set the app authenticates via
# Microsoft SSO. When omitted, the app runs in dev mode using the header-based
# identity switcher in the sidebar (mirrors the backend's dev-mode auth).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
