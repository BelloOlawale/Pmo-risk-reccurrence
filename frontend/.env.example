# Base URL for the backend API. Leave empty to use the Vite dev proxy
# (relative /api URLs). Set to an absolute URL when the API lives elsewhere.
VITE_API_BASE_URL=

# Authentication mode.
#   password (default) — app-managed email + password sign-in.
#   dev                — header-based developer auth + sidebar switcher.
# Local development only; deployed builds use the default.
VITE_AUTH_MODE=dev
