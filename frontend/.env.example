# Base URL for the backend API. Leave empty to use the Vite dev proxy
# (relative /api URLs). Set to an absolute URL when the API lives elsewhere.
VITE_API_BASE_URL=

# Authentication mode (build-time).
#   entra    — Microsoft Entra ID SSO via MSAL (production). Requires the two
#              VITE_ENTRA_* values below and the matching RISKAPP_ENTRA_*
#              backend settings.
#   password — app-managed email + password sign-in (fallback / local only).
VITE_AUTH_MODE=entra

# Entra ID (MSAL) configuration — required when VITE_AUTH_MODE=entra. These must
# match the backend's RISKAPP_ENTRA_CLIENT_ID / RISKAPP_ENTRA_TENANT_ID so the
# SPA requests a token for the same app registration the API validates.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
